{
  "manifest_version": 3,
  "author": "Thierry Huchard",
  "browser_specific_settings": {
    "gecko": {
      "id": "eds-contacts-integration-v162@thierryh.local",
      "strict_min_version": "153.0"
    }
  },
  "default_locale": "en-US",
  "name": "__MSG_extensionName__",
  "description": "__MSG_extensionDescription__",
  "version": "2.0.4",
  "icons": {
    "16": "icons/eds-contacts.svg",
    "32": "icons/eds-contacts.svg",
    "64": "icons/eds-contacts.svg"
  },
  "permissions": [
    "storage",
    "addressBooks",
    "nativeMessaging"
  ],
  "background": {
    "page": "background.html"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  }
}
